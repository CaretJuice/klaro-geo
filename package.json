{
    "name": "klaro-geo",
    "version": "0.3.4",
    "description": "Klaro Geo WordPress Plugin",
    "main": "index.js",
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "e2e:install": "npx playwright install chromium firefox",
        "test:php": "bin/phpunit.sh",
        "site:up": "bin/site.sh up",
        "site:reset": "bin/site.sh reset",
        "site:down": "bin/site.sh down",
        "e2e:setup": "bin/site.sh reset",
        "e2e:test": "playwright test",
        "e2e:test:headed": "playwright test --headed",
        "e2e:test:debug": "playwright test --debug",
        "e2e:test:ui": "playwright test --ui",
        "e2e:report": "playwright show-report e2e-report",
        "e2e": "npm run e2e:setup && npm run e2e:test",
        "plugin-check": "bin/plugin-check.sh",
        "e2e:full": "npm run e2e:setup && npm run e2e:test && npm run site:down"
    },
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@babel/core": "^7.22.5",
        "@babel/preset-env": "^7.22.5",
        "@playwright/test": "^1.56.1",
        "babel-jest": "^30.3.0",
        "jest": "^30.3.0",
        "jest-environment-jsdom": "^30.3.0"
    },
    "jest": {
        "testEnvironment": "jsdom",
        "moduleFileExtensions": [
            "js"
        ],
        "testMatch": [
            "**/tests/js/test-*.js"
        ],
        "testPathIgnorePatterns": [
            "/node_modules/",
            "/tests/js/setup.js"
        ],
        "transform": {
            "^.+\\.js$": "babel-jest"
        },
        "setupFiles": [
            "./tests/js/setup.js"
        ],
        "collectCoverage": false,
        "collectCoverageFrom": [
            "js/*.js",
            "!js/vendor/**"
        ]
    }
}
